emod = 1

# Order Processing — Dynamic Consistency Boundary model
# Events carry tags so commands can express cross-cutting consistency
# boundaries via tag-scoped queries
model "Order Management" {
}

actor "Customer" {
}

context "Fulfillment" {
  mode = dcb

  slice "Place Order" {
    command "PlaceOrder" {
      fields {
        customerId = required(string)
        orderType  = required(string)
        total      = required(int)
      }
    }

    event "OrderPlaced" {
      tags {
        entity   = customerId
        category = orderType
      }

      fields {
        orderId    = required(string)
        customerId = required(string)
        orderType  = required(string)
        total      = required(int)
        placedAt   = required(timestamp)
      }
    }

    flow = <<-FLOW
      command -> event:    PlaceOrder -> OrderPlaced
    FLOW
  }

  slice "Authorize Payment" {
    command "AuthorizePayment" {
      fields {
        paymentId = required(string)
        authCode  = required(string)
      }

      decides_on {
        events = [OrderPlaced]
        where  = tag(entity, customerId) && tag(category, orderType)
      }
    }

    event "PaymentAuthorized" {
      tags {
        entity   = customerId
        category = orderType
      }

      fields {
        paymentId  = required(string)
        orderId    = required(string)
        customerId = required(string)
        orderType  = required(string)
        authCode   = required(string)
      }
    }

    flow = <<-FLOW
      command -> event:    AuthorizePayment -> PaymentAuthorized
    FLOW
  }

  slice "Ship Order" {
    command "ShipOrder" {
      fields {
        shipmentId = required(string)
      }

      decides_on {
        events = [OrderPlaced]
        where  = tag(entity, customerId)
      }
    }

    event "OrderShipped" {
      tags {
        entity = customerId
      }

      fields {
        shipmentId = required(string)
        orderId    = required(string)
        customerId = required(string)
      }
    }

    flow = <<-FLOW
      command -> event:    ShipOrder -> OrderShipped
    FLOW
  }

  slice "Notify Customer" {
    command "SendNotification" {
      fields {
        message = required(string)
      }

      decides_on {
        events = [PaymentAuthorized, OrderShipped]
        where  = tag(entity, customerId)
      }
    }

    event "NotificationSent" {
      tags {
        entity = customerId
      }

      fields {
        notificationId = required(string)
        orderId        = required(string)
        customerId     = required(string)
        message        = required(string)
      }
    }

    flow = <<-FLOW
      command -> event:    SendNotification -> NotificationSent
    FLOW
  }
}
