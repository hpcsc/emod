# This file carries intentional faults, so the viewer and the CLI have a model
# whose partial rendering and diagnostics can be exercised.
emod = 1

model "Error Diagnostics Test" {
}

actor "Guest" {
}

context "Reservations" {
  aggregate "Reservation" {
    # Slice 1: valid, and renders on its own
    slice "Reserve a Room" {
      command "ReserveRoom" {
        fields {
          roomId    = string
          guestName = string
        }
      }

      event "RoomReserved" {
        fields {
          reservationId = string
          roomId        = string
        }
      }

      flow = <<-FLOW
        command -> event: ReserveRoom -> RoomReserved
      FLOW
    }

    # Slice 2: the flow names an event no slice declares
    slice "Check Out" {
      command "CheckOutGuest" {
        fields {
          reservationId = string
        }
      }

      flow = <<-FLOW
        command -> event: CheckOutGuest -> GuestCheckedOut
      FLOW
    }

    # Slice 3: valid, and renders after the fault above it
    slice "View Rooms" {
      view "AvailableRoomsView" {
        subscribes = [RoomReserved]

        fields {
          roomId = string
        }
      }
    }
  }
}

# The command here is orphaned: no flow, automation or translation names it.
context "Notifications" {
  aggregate "Notification" {
    slice "Send" {
      command "SendEmail" {
        fields {
          email = string
        }
      }
    }
  }
}
