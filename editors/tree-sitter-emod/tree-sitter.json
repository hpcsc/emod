{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "emod",
      "camelcase": "Emod",
      "scope": "source.emod",
      "path": ".",
      "file-types": [
        "emod"
      ],
      "highlights": [
        "queries/highlights.scm"
      ],
      "injection-regex": "^emod$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for EMOD DSL",
    "links": {
      "repository": "https://github.com/hpcsc/emod"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": true,
    "python": false,
    "rust": false,
    "swift": false
  }
}
