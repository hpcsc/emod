{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "source.emod",
  "fileTypes": ["emod"],
  "name": "emod",
  "patterns": [
    { "include": "#comments" },
    { "include": "#fields-block" },
    { "include": "#keyword-entity" },
    { "include": "#activations" },
    { "include": "#standalone-tokens" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.number-sign.emod",
      "match": "#.*$"
    },
    "strings": {
      "name": "string.quoted.double.emod",
      "match": "\"[^\"]*\""
    },
    "fields-block": {
      "comment": "A field name, type and modifier are all free identifiers, so an activation is unreadable from one field line alone; the block boundary is what tells the two apart.",
      "begin": "(?i)\\b(fields)\\b\\s*(\\{)?",
      "beginCaptures": {
        "1": { "name": "keyword.control.emod" },
        "2": { "name": "keyword.operator.emod" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "keyword.operator.emod" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#keyword-entity" },
        { "include": "#standalone-tokens" }
      ]
    },
    "keyword-entity": {
      "patterns": [
        {
          "comment": "Keywords followed by quoted entity name",
          "match": "(?i)\\b(model|actor|context|aggregate|slice|trigger)\\s+(\"[^\"]*\")",
          "captures": {
            "1": { "name": "keyword.control.emod" },
            "2": { "name": "entity.name.function.emod" }
          }
        },
        {
          "comment": "Keywords followed by identifier entity name",
          "match": "(?i)\\b(command|event|view|automation|translation)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.emod" },
            "2": { "name": "entity.name.function.emod" }
          }
        },
        {
          "comment": "target keyword with type and trailing entity name",
          "match": "(?i)\\b(target)\\s+[A-Za-z_][A-Za-z0-9_]*\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.emod" },
            "2": { "name": "entity.name.function.emod" }
          }
        }
      ]
    },
    "activations": {
      "comment": "Deliberately case-sensitive, unlike the rules above: the lexer's keyword lookup is too, so On and Every are legal entity names.",
      "patterns": [
        {
          "comment": "Event-driven activation and the event it names",
          "match": "\\b(on)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.control.emod" },
            "2": { "name": "entity.name.function.emod" }
          }
        },
        {
          "comment": "Schedule-driven activation; the schedule itself stays a string literal",
          "match": "\\bevery(?=\\s+\")",
          "name": "keyword.control.emod"
        }
      ]
    },
    "standalone-tokens": {
      "patterns": [
        { "include": "#strings" },
        { "include": "#keywords" },
        { "include": "#field-modifiers" },
        { "include": "#field-types" },
        { "include": "#operators" },
        { "include": "#punctuation" }
      ]
    },
    "keywords": {
      "comment": "Every lexer keyword except on and every, which #activations colours case-sensitively so a field named after one stays a field. Longer spellings precede the shorter ones they contain (events before event, tags before tag) to keep the alternation readable; the surrounding \\b makes the order immaterial.",
      "match": "(?i)\\b(model|actor|context|aggregate|slice|command|events|event|fields|flow|trigger|view|automation|translation|subscribes|reads|source|external_system|external|target|mode|tags|tag|decides_on|where|and|or|not|emod|description|invariant|spec|given|when|then|rejected)\\b",
      "name": "keyword.control.emod"
    },
    "field-modifiers": {
      "match": "\\b(required|optional)\\b",
      "name": "storage.modifier.emod"
    },
    "field-types": {
      "match": "\\b(string|date|timestamp|int)\\b",
      "name": "storage.type.emod"
    },
    "operators": {
      "match": "(->|:|=)",
      "name": "keyword.operator.emod"
    },
    "punctuation": {
      "match": "[\\{\\}\\[\\],]",
      "name": "keyword.operator.emod"
    }
  }
}
