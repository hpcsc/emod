{
  "name": "emod",
  "displayName": "Emod Language Support",
  "description": "Syntax highlighting for Emod (.emod) files — a domain modeling language",
  "version": "0.1.0",
  "publisher": "hpcsc",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:emod"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "emod",
        "aliases": ["emod", "Emod"],
        "extensions": [".emod"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "emod",
        "scopeName": "source.emod",
        "path": "./syntaxes/emod.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./tsconfig.json",
    "watch": "tsc -watch -p ./tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/vscode": "^1.84.0",
    "@types/node": "^20.0.0",
    "vscode-languageclient": "^9.0.1"
  }
}
