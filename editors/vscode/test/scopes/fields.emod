# SYNTAX TEST "source.emod"

command PlaceOrder {
  fields {
# ^^^^^^ keyword.control.emod
    orderId string required
#   ^^^^^^^ variable.other.member.emod - keyword.control.emod entity.name.function.emod storage.type.emod storage.modifier.emod
#           ^^^^^^ storage.type.emod
#                  ^^^^^^^^ storage.modifier.emod - storage.type.emod
# A field may be named after a keyword, and it takes the same scope the ordinary
# name above does: the treatment keys on the line's position inside the block, so
# there is no spelling it can be wrong about.
    command string required
#   ^^^^^^^ variable.other.member.emod - keyword.control.emod entity.name.function.emod
#           ^^^^^^ storage.type.emod - entity.name.function.emod
#                  ^^^^^^^^ storage.modifier.emod
    quantity int
#   ^^^^^^^^ variable.other.member.emod - keyword.control.emod entity.name.function.emod storage.type.emod storage.modifier.emod
#            ^^^ storage.type.emod
  }
}
