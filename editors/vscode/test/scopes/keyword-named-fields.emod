# SYNTAX TEST "source.emod"

# A field name is claimed by where it sits inside the block, never by what it
# spells, so every keyword the language defines reads as a field name here.
command RecordMetadata {
  fields {
    emod string required
#   ^^^^ variable.other.member.emod - keyword.control.emod entity.name.function.emod
#        ^^^^^^ storage.type.emod
#               ^^^^^^^^ storage.modifier.emod
    description string required
#   ^^^^^^^^^^^ variable.other.member.emod - keyword.control.emod entity.name.function.emod
#               ^^^^^^ storage.type.emod
#                      ^^^^^^^^ storage.modifier.emod
    invariant string required
#   ^^^^^^^^^ variable.other.member.emod - keyword.control.emod entity.name.function.emod
#             ^^^^^^ storage.type.emod
#                    ^^^^^^^^ storage.modifier.emod
    spec string required
#   ^^^^ variable.other.member.emod - keyword.control.emod entity.name.function.emod
#        ^^^^^^ storage.type.emod
#               ^^^^^^^^ storage.modifier.emod
    given string required
#   ^^^^^ variable.other.member.emod - keyword.control.emod entity.name.function.emod
#         ^^^^^^ storage.type.emod
#                ^^^^^^^^ storage.modifier.emod
    when string required
#   ^^^^ variable.other.member.emod - keyword.control.emod entity.name.function.emod
#        ^^^^^^ storage.type.emod
#               ^^^^^^^^ storage.modifier.emod
    then string required
#   ^^^^ variable.other.member.emod - keyword.control.emod entity.name.function.emod
#        ^^^^^^ storage.type.emod
#               ^^^^^^^^ storage.modifier.emod
    rejected string required
#   ^^^^^^^^ variable.other.member.emod - keyword.control.emod entity.name.function.emod
#            ^^^^^^ storage.type.emod
#                   ^^^^^^^^ storage.modifier.emod
# The rule has no per-spelling axis, so it reaches every keyword. These three
# name constructs that have nothing to do with specs or metadata.
    flow string required
#   ^^^^ variable.other.member.emod - keyword.control.emod entity.name.function.emod
#        ^^^^^^ storage.type.emod
#               ^^^^^^^^ storage.modifier.emod
    reads string required
#   ^^^^^ variable.other.member.emod - keyword.control.emod entity.name.function.emod
#         ^^^^^^ storage.type.emod
#                ^^^^^^^^ storage.modifier.emod
    decides_on string required
#   ^^^^^^^^^^ variable.other.member.emod - keyword.control.emod entity.name.function.emod
#              ^^^^^^ storage.type.emod
#                     ^^^^^^^^ storage.modifier.emod
  }
}

# A field written on the block's own opening line reads the same way. Nothing
# anchored to the start of a line can reach it, since begin has already consumed
# that line, so the block's own opening match claims it instead. The form is
# legal input but never formatter output - internal/formatter/formatter.go
# writes one field per line.
command RecordInline { fields { description string required } }
#                               ^^^^^^^^^^^ variable.other.member.emod - keyword.control.emod
#                                           ^^^^^^ storage.type.emod
#                                                  ^^^^^^^^ storage.modifier.emod

# Only the name is claimed. A keyword in a field's type or modifier position is
# still painted as a keyword, which the tree-sitter query is not - it captures
# all three positions structurally. Claiming the other two here would leave the
# flat alternation with no witness anywhere inside a fields block, retiring
# guards two other stories rely on, so the divergence is recorded rather than
# repaired.
command RecordTyped {
  fields {
    blurb description required
#         ^^^^^^^^^^^ keyword.control.emod
    versioned string emod
#                    ^^^^ keyword.control.emod
  }
}

# A tag entry's value names a field, so a field named true is not a literal here.
event DeskClaimed { tags { entity: true } }
#                          ^^^^^^ - constant.language.boolean.emod
#                                  ^^^^ - constant.language.boolean.emod
