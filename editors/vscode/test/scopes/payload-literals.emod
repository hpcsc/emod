# SYNTAX TEST "source.emod"

# A payload value is the only place the language writes a bare number or a bare
# true, so both are keyed on the colon introducing them. Outside that position
# each spelling is ordinary text - a field named true is a field name, and a
# digit inside an identifier or a quoted string belongs to what encloses it.
context "Lending" {
  aggregate "Loan" {
    slice "Borrow a Copy" {
      spec "borrows a copy no one holds" {
        given [CopyReturned { copyId: "C-93204", renewals: 4821 }]
#                                     ^^^^^^^^^ string.quoted.double.emod - constant.numeric.emod
#                                                          ^^^^ constant.numeric.emod - string.quoted.double.emod
        when BorrowCopy { lateFee: 12.50, expedited: true }
#                                  ^^^^^ constant.numeric.emod
#                                                    ^^^^ constant.language.boolean.emod - entity.name.function.emod
        then [CopyBorrowed { renewals: 0, expedited: false }]
#                                      ^ constant.numeric.emod
#                                                    ^^^^^ constant.language.boolean.emod - entity.name.function.emod
      }
    }
  }
}

# A payload field's name is left alone on both surfaces - it matches the DCB tag
# key beside it, which carries no scope either. Where that name is spelled like a
# keyword the flat alternation still reaches it, which tree-sitter does not do.
context "Named" {
  slice "S" {
    spec "s" {
      when PlaceOrder { spec: 1, roomId: 2 }
#                       ^^^^ keyword.control.emod
#                                ^^^^^^ - keyword.control.emod
    }
  }
}

# A payload field may be named after a keyword that opens a block elsewhere. The
# literals after it must survive, which they only do while #tags-block requires
# its brace - without that it opens here and swallows the rest of the payload.
context "BlockNamed" {
  slice "S" {
    spec "s" {
      when Claim { tags: 1, amount: 42, ok: true }
#                        ^ constant.numeric.emod
#                                   ^^ constant.numeric.emod
#                                           ^^^^ constant.language.boolean.emod
    }
  }
}

# The parser compares a boolean value exactly (internal/parser), so a capitalised
# one is not a literal. An editor paints text mid-edit, and painting True as a
# boolean would report a value the language will reject as one it accepts.
context "Recheck" {
  slice "S" {
    spec "s" {
      when Recheck { expedited: True }
#                               ^^^^ - constant.language.boolean.emod
    }
  }
}

# A field named true is a field name. Its name is claimed by #field-name before
# any later rule is consulted, so the witness for a positionless boolean rule is
# a field *typed* true, which nothing claims ahead of it.
event CopyReturned {
  fields {
    true bool required
#   ^^^^ variable.other.member.emod - constant.language.boolean.emod
    false bool required
#   ^^^^^ variable.other.member.emod - constant.language.boolean.emod
    flag true required
#        ^^^^ - constant.language.boolean.emod keyword.control.emod
    marked bool false
#               ^^^^^ - constant.language.boolean.emod keyword.control.emod
  }
}

# A digit inside an identifier is part of the identifier. Two things keep it that
# way and only one of them is this rule's colon: there is also no word boundary
# between a letter and the digit following it, so a shape-only numeric rule would
# leave these alone too. The version header above is the case that separates the
# two, and it is the one a de-positionalising mutation reddens.
event Version2Placed {
#     ^^^^^^^^^^^^^^ entity.name.function.emod - constant.numeric.emod
  fields {
    line1 string required
#   ^^^^^ variable.other.member.emod - constant.numeric.emod
  }
}
