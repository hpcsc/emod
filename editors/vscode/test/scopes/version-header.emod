# SYNTAX TEST "source.emod"

# A file may open by naming the language version. No other assertion file
# reaches that keyword, so this is where it is pinned.
emod 1
# <---- keyword.control.emod
#    ^ - constant.numeric.emod

# The numeric rule keys on the colon that introduces a payload value, so a
# header's version number is left as plain text. The tree-sitter query answers
# the same way, for its own reason: those digits parse as (integer), and only
# (number) carries a literal capture there.
