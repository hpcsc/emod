# SYNTAX TEST "source.emod"

model "Order Management" {
# <----- keyword.control.emod
#     ^^^^^^^^^^^^^^^^^^ entity.name.function.emod - string.quoted.double.emod
  actor "Customer" {}
# ^^^^^ keyword.control.emod
#       ^^^^^^^^^^ entity.name.function.emod - string.quoted.double.emod
}

context "Ordering" {
# <------- keyword.control.emod
#       ^^^^^^^^^^ entity.name.function.emod - string.quoted.double.emod
  aggregate "Order" {
# ^^^^^^^^^ keyword.control.emod
#           ^^^^^^^ entity.name.function.emod - string.quoted.double.emod
    slice "Placement" {
#   ^^^^^ keyword.control.emod
#         ^^^^^^^^^^^ entity.name.function.emod - string.quoted.double.emod
      command PlaceOrder {}
#     ^^^^^^^ keyword.control.emod
#             ^^^^^^^^^^ entity.name.function.emod
      event OrderPlaced {}
#     ^^^^^ keyword.control.emod
#           ^^^^^^^^^^^ entity.name.function.emod
# Not a typo: keyword lookup is case-sensitive, so On and Every are legal event names.
      event On {}
#     ^^^^^ keyword.control.emod
#           ^^ entity.name.function.emod - keyword.control.emod
      event Every {}
#     ^^^^^ keyword.control.emod
#           ^^^^^ entity.name.function.emod - keyword.control.emod
      view OrderSummary {}
#     ^^^^ keyword.control.emod
#          ^^^^^^^^^^^^ entity.name.function.emod
      automation NotifyCustomer {
#     ^^^^^^^^^^ keyword.control.emod
#                ^^^^^^^^^^^^^^ entity.name.function.emod
        on OrderPlaced
#       ^^ keyword.control.emod
#          ^^^^^^^^^^^ entity.name.function.emod - keyword.control.emod
        reads OrderSummary
#       ^^^^^ keyword.control.emod
#             ^^^^^^^^^^^^ - entity.name.function.emod
        target context Notifications
#       ^^^^^^ keyword.control.emod
#                      ^^^^^^^^^^^^^ entity.name.function.emod
      }
      translation ImportOrder {}
#     ^^^^^^^^^^^ keyword.control.emod
#                 ^^^^^^^^^^^ entity.name.function.emod
      trigger "Review orders" {
#     ^^^^^^^ keyword.control.emod
#             ^^^^^^^^^^^^^^^ entity.name.function.emod - string.quoted.double.emod
        actor Customer
#       ^^^^^ keyword.control.emod
#             ^^^^^^^^ - entity.name.function.emod
      }
    }
  }
}

# Not a stray line: a half-typed declaration is the case under test.
trigger
# <------- keyword.control.emod
