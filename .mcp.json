{
  "mcpServers": {
    "gopls": {
      "type": "stdio",
      "command": "gopls",
      "args": [
        "mcp"
      ],
      "env": {}
    },
    "emod": {
      "type": "stdio",
      "command": "emod",
      "args": [
        "mcp",
        "--root",
        "."
      ],
      "env": {}
    }
  }
}