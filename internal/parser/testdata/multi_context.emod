emod = 1

# Multi-context model with cross-context automation and external source event
model "Order Management" {
}

context "Orders" {
  aggregate "Order" {
    # A customer commits to buying and the shop records it
    slice "Place Order" {
      command "PlaceOrder" {
        fields {
          orderId    = required(string)
          customerId = required(string)
        }
      }

      event "OrderPlaced" {
        fields {
          orderId    = required(string)
          customerId = required(string)
          placedAt   = required(timestamp)
        }
      }

      flow = <<-FLOW
        command -> event:    PlaceOrder -> OrderPlaced
      FLOW
    }

    slice "Notify On Order" {
      view "PendingNotificationsView" {
        subscribes = [OrderPlaced]

        fields {
          orderId    = required(string)
          customerId = required(string)
          placedAt   = required(timestamp)
        }
      }

      automation "OrderNotifier" {
        on      = OrderPlaced
        reads   = PendingNotificationsView
        command = SendNotification

        target {
          context = Notifications
        }
      }
    }
  }
}

context "Notifications" {
  aggregate "Notification" {
    # The notice the order side asked for leaves the building
    slice "Send Notification" {
      command "SendNotification" {
        fields {
          message = required(string)
        }
      }

      event "NotificationReceived" {
        source = external("Email Provider")

        fields {
          notificationId = required(string)
          receivedAt     = required(timestamp)
        }
      }

      flow = <<-FLOW
        command -> event:    SendNotification -> NotificationReceived
      FLOW
    }
  }
}
